PORT=3100
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
REQUEST_TIMEOUT_MS=45000
MAX_MESSAGE_LENGTH=1500
ADMIN_PASSWORD=replace-with-a-secure-password

# Production only. Leave unset for local development.
#
# Number of proxies in front of the app (Hostinger / nginx = 1).
# Needed so rate limits and admin lockout see real visitor IPs.
# Do not set it when the app is reached directly, or visitors
# could fake their IP address.
# TRUST_PROXY=1
#
# Live knowledge file kept outside the git checkout so admin
# edits survive code updates. Seeded from data/knowledge-base.json
# on first start.
# KNOWLEDGE_DATA_PATH=/var/lib/iim-chatbot/knowledge-base.json

# Chat messages allowed per visitor per minute (0 disables;
# use 0 locally when running npm run test:chatbot).
CHAT_RATE_LIMIT_PER_MINUTE=20

# Answer ratings file. Defaults to feedback.jsonl beside the
# knowledge file (outside git when KNOWLEDGE_DATA_PATH is set).
# FEEDBACK_DATA_PATH=/var/lib/iim-chatbot/feedback.jsonl

# WhatsApp number for the "contact a human" card: digits with
# country code, no + or spaces. Leave empty to show email only.
# Use only a number IIM has confirmed for WhatsApp enquiries.
HANDOFF_WHATSAPP=

# Websites allowed to show the chatbot with embed.js,
# separated by spaces. See docs/embedding.md.
# EMBED_ALLOWED_ORIGINS=https://iim-africa.org https://www.iim-africa.org
